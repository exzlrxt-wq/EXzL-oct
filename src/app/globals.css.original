/* ══ DESIGN TOKENS ══ */
:root {
  --bg: #0e0d0b;
  --bg2: #131210;
  --bg3: #1a1916;
  --ink: #e8e3d8;
  --ink2: rgba(232,227,216,.45);
  --muted: #3d3b36;
  --acid: #c9f135;
  --acid-dim: rgba(201,241,53,.07);
  --border: rgba(255,255,255,.07);
  --border2: rgba(255,255,255,.13);
  --serif: 'Cormorant Garamond', Georgia, serif;
  --sans: 'Syne', sans-serif;
  --mono: 'JetBrains Mono', monospace;
  --expo: cubic-bezier(.16, 1, .3, 1);
  --back: cubic-bezier(.34, 1.56, .64, 1);
  --hard: cubic-bezier(.76, 0, .24, 1);
}

*, *::before, *::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  overflow-x: clip;
  scroll-behavior: auto;
  /* Required by Framer Motion useScroll container check */
  position: relative;
}

/* ══ LENIS ══ */
html.lenis, html.lenis body { height: auto; }
.lenis.lenis-smooth { scroll-behavior: auto !important; }
.lenis.lenis-smooth [data-lenis-prevent] { overscroll-behavior: contain; }
.lenis.lenis-stopped { overflow: hidden; }
.lenis.lenis-smooth iframe { pointer-events: none; }

body {
  background: var(--bg);
  color: var(--ink);
  font-family: var(--sans);
  font-weight: 400;
  overflow-x: clip;
  cursor: none;
}

/* Hide custom cursor on touch/mobile devices */
@media (hover: none) and (pointer: coarse) {
  body { cursor: auto; }
  #cdot, #cring, #ctxt { display: none !important; }
}

/* Grain texture handled by <GrainOverlay /> canvas component in layout.js */
/* Drifting glyphs handled by <GlyphBg /> canvas component in layout.js */

/* ══ PROGRESS BAR ══ */
#progress-bar {
  position: fixed;
  top: 0;
  left: 0;
  height: 1px;
  background: var(--acid);
  z-index: 99998;
  width: 0;
  transition: width .06s;
  box-shadow: 0 0 6px var(--acid);
}

/* ══ SIDE LABEL ══ */
.side-label {
  position: fixed;
  left: 20px;
  top: 50%;
  transform: translateY(-50%) rotate(180deg);
  z-index: 500;
  writing-mode: vertical-rl;
  font-family: var(--mono);
  font-size: 7px;
  text-transform: uppercase;
  letter-spacing: .28em;
  color: var(--muted);
  pointer-events: none;
  transition: color .3s;
}

/* ══ STENCIL GHOST TEXT ══ */
.stencil {
  position: absolute;
  font-family: var(--serif);
  font-weight: 700;
  color: transparent;
  -webkit-text-stroke: 1px rgba(232, 227, 216, .05);
  pointer-events: none;
  user-select: none;
  letter-spacing: -.04em;
  line-height: 1;
  white-space: nowrap;
}

/* ══ SECTION SHARED ══ */
section {
  padding: 120px 56px;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 64px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--border);
}

.section-label {
  font-family: var(--mono);
  font-size: 7px;
  text-transform: uppercase;
  letter-spacing: .3em;
  color: var(--muted);
  margin-bottom: 10px;
}

.section-title {
  font-family: var(--serif);
  font-size: clamp(38px, 5vw, 76px);
  font-weight: 700;
  line-height: .9;
  letter-spacing: -.025em;
}

.section-title em {
  font-style: italic;
  color: var(--acid);
}

.section-hint {
  font-family: var(--mono);
  font-size: 7px;
  text-transform: uppercase;
  letter-spacing: .18em;
  color: var(--muted);
  text-align: right;
  line-height: 2.2;
}

/* ══ MAGNETIC BUTTON GLOBAL ══ */
.mag-btn {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  font-family: var(--mono);
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: .18em;
  color: var(--acid);
  background: var(--bg);
  border: 1px solid rgba(201, 241, 53, .3);
  padding: 16px 32px;
  text-decoration: none;
  white-space: nowrap;
  transition: background .25s, border-color .25s, transform .4s var(--expo);
  position: relative;
  cursor: none;
}
.mag-btn:hover {
  background: rgba(201, 241, 53, .06);
  border-color: var(--acid);
}

/* ══ MICRO DETAIL: acid line ══ */
.sec-acid-line {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0;
  height: 1px;
  background: var(--acid);
  transition: width 1.2s var(--expo);
}
.sec-acid-line.on { width: 100%; }

/* ══ KEYFRAMES ══ */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(28px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes dpulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: .3; transform: scale(.6); }
}

@keyframes vl {
  0%, 100% { opacity: .35; }
  50% { opacity: 1; }
}

@keyframes mqs {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

@keyframes floatDot {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-6px); }
}

@keyframes bfloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-4px); }
}
.bfloat {
  display: inline-block;
  animation: bfloat 4.2s cubic-bezier(0.35, 0, 0.25, 1) infinite;
  will-change: transform;
}

/* ══ SELECTION ══ */
::selection {
  background: var(--acid);
  color: var(--bg);
}

/* ══ SCROLLBAR ══ */
::-webkit-scrollbar { width: 2px; }
::-webkit-scrollbar-track { background: var(--bg2); }
::-webkit-scrollbar-thumb { background: var(--acid); border-radius: 1px; }

/* ══ REDUCED MOTION ══ */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
  .bfloat { animation: none; }
  body { transition: none; }
}

/* ══ RESPONSIVE — Tablet ══ */
@media (max-width: 1000px) {
  section {
    padding-left: 24px;
    padding-right: 24px;
  }
  .side-label { display: none; }
}

/* ══ RESPONSIVE — Mobile ══ */
@media (max-width: 600px) {
  section {
    padding: 80px 16px;
  }
  .mag-btn {
    padding: 14px 24px;
    font-size: 8px;
  }
}
