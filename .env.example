# ─── EXZLR Landing — Environment Variables ──────────────────────────────────
#
# Copy this file to .env.local and fill in real values for local dev.
# On Vercel, add these in Project → Settings → Environment Variables.
# Never commit .env.local to git.
#

# Resend API key — get one free at https://resend.com
# Required for the contact form to email you at admin@exzlr.com
# Free tier: 3,000 emails/month, 100/day — plenty for a lead form
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Dashboard URL — the EXZLR OS app (used in Nav + CTA links)
# Change to your live app domain when deployed
NEXT_PUBLIC_DASHBOARD_URL=https://app.exzlr.com

# Booking URL — your Cal.com or Calendly link
NEXT_PUBLIC_CAL_URL=https://cal.com/exzlr.corp/30min
